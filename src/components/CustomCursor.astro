---
// CustomCursor.astro — Premium custom cursor with interactive ambient light and click pulse
---

<div id="cursor-glow" class="fixed top-0 left-0 w-[400px] h-[400px] bg-gradient-to-r from-blue-500/20 via-indigo-500/20 to-purple-500/15 rounded-full blur-[100px] pointer-events-none z-[45] hidden md:block opacity-80" style="transform: translate(-50%, -50%)"></div>
<div id="cursor-dot" class="fixed top-0 left-0 w-2.5 h-2.5 bg-white rounded-full pointer-events-none z-[60] mix-blend-difference hidden md:block" style="transform: translate(-50%, -50%)"></div>
<div id="cursor-ring" class="fixed top-0 left-0 w-10 h-10 rounded-full pointer-events-none z-[60] mix-blend-difference border border-white/60 hidden md:block" style="transform: translate(-50%, -50%)"></div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof gsap === 'undefined') return;
    
    const dot = document.getElementById('cursor-dot');
    const ring = document.getElementById('cursor-ring');
    const glow = document.getElementById('cursor-glow');
    
    if (!dot || !ring || !glow) return;

    // Check for touch device
    if ('ontouchstart' in window) {
      dot.style.display = 'none';
      ring.style.display = 'none';
      glow.style.display = 'none';
      return;
    }

    let isHovering = false;
    let isMouseDown = false;

    const dotX = gsap.quickTo(dot, "x", { duration: 0.1, ease: "power3" });
    const dotY = gsap.quickTo(dot, "y", { duration: 0.1, ease: "power3" });
    const ringX = gsap.quickTo(ring, "x", { duration: 0.35, ease: "power3" });
    const ringY = gsap.quickTo(ring, "y", { duration: 0.35, ease: "power3" });
    const glowX = gsap.quickTo(glow, "x", { duration: 0.6, ease: "power3" });
    const glowY = gsap.quickTo(glow, "y", { duration: 0.6, ease: "power3" });

    window.addEventListener('mousemove', (e) => {
      dotX(e.clientX);
      dotY(e.clientY);
      ringX(e.clientX);
      ringY(e.clientY);
      glowX(e.clientX);
      glowY(e.clientY);
    });

    // Handle Click Down (MouseDown) — Light stays ON & pulses brightly!
    window.addEventListener('mousedown', () => {
      isMouseDown = true;
      gsap.to(dot, { scale: 0.5, duration: 0.15, ease: "power2.out" });
      gsap.to(ring, { 
        scale: isHovering ? 1.5 : 0.75, 
        borderColor: 'rgba(255,255,255,0.9)', 
        duration: 0.15, 
        ease: "power2.out" 
      });
      gsap.to(glow, { 
        scale: 1.3, 
        opacity: 1, 
        duration: 0.15, 
        ease: "power2.out" 
      });
    });

    // Handle Click Release (MouseUp) — Bounces back smoothly!
    window.addEventListener('mouseup', () => {
      isMouseDown = false;
      gsap.to(dot, { 
        scale: isHovering ? 0.3 : 1, 
        duration: 0.35, 
        ease: "back.out(2)" 
      });
      gsap.to(ring, { 
        scale: isHovering ? 2.2 : 1, 
        borderColor: isHovering ? 'rgba(255,255,255,0.3)' : 'rgba(255,255,255,0.6)', 
        duration: 0.35, 
        ease: "back.out(2)" 
      });
      gsap.to(glow, { 
        scale: 1, 
        opacity: 0.8, 
        duration: 0.35, 
        ease: "power2.out" 
      });
    });

    // Attach Hover interactions dynamically
    function setupHoverListeners() {
      const hoverables = document.querySelectorAll('a, button, [role="button"], input, textarea, select, .magnetic-btn, .bento-card, .nav-item, .project-panel, .testi-card');
      
      hoverables.forEach(el => {
        el.addEventListener('mouseenter', () => {
          isHovering = true;
          if (!isMouseDown) {
            gsap.to(ring, { scale: 2.2, borderColor: 'rgba(255,255,255,0.3)', duration: 0.3 });
            gsap.to(dot, { scale: 0.3, duration: 0.3 });
            gsap.to(glow, { scale: 1.15, opacity: 0.9, duration: 0.3 });
          }
        });
        el.addEventListener('mouseleave', () => {
          isHovering = false;
          if (!isMouseDown) {
            gsap.to(ring, { scale: 1, borderColor: 'rgba(255,255,255,0.6)', duration: 0.3 });
            gsap.to(dot, { scale: 1, duration: 0.3 });
            gsap.to(glow, { scale: 1, opacity: 0.8, duration: 0.3 });
          }
        });
      });
    }

    setupHoverListeners();

    // Re-bind hover listeners periodically or on DOM changes for dynamically loaded content
    const observer = new MutationObserver(() => setupHoverListeners());
    observer.observe(document.body, { childList: true, subtree: true });

    // Handle mouse leaving/entering browser window
    document.addEventListener('mouseleave', () => {
      gsap.to([dot, ring, glow], { opacity: 0, duration: 0.4 });
    });
    document.addEventListener('mouseenter', () => {
      gsap.to(dot, { opacity: 1, duration: 0.4 });
      gsap.to(ring, { opacity: 1, duration: 0.4 });
      gsap.to(glow, { opacity: 0.8, duration: 0.4 });
    });
  });
</script>

<style>
  /* Hide default cursor on desktop */
  @media (hover: hover) and (pointer: fine) {
    :global(body) {
      cursor: none;
    }
    :global(a, button, [role="button"], input, textarea, select) {
      cursor: none;
    }
  }
</style>
