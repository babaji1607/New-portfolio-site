---
// FloatingNav.astro — Fixed trigger button + full-screen creative menu overlay
---

<!-- Fixed menu trigger -->
<button id="menu-trigger" class="fixed top-6 right-6 z-[70] flex items-center gap-3 group" aria-label="Open menu">
  <span class="menu-label text-sm font-medium text-white/60 group-hover:text-white transition-colors hidden md:block">Menu</span>
  <div class="w-12 h-12 rounded-full bg-white/10 backdrop-blur-md border border-white/10 flex flex-col items-center justify-center gap-1.5 group-hover:bg-white/15 transition-all duration-300">
    <span class="menu-line block w-5 h-[1.5px] bg-white transition-all duration-300 origin-center"></span>
    <span class="menu-line block w-5 h-[1.5px] bg-white transition-all duration-300 origin-center"></span>
  </div>
</button>

<!-- Full-screen menu overlay -->
<div id="menu-overlay" class="fixed inset-0 z-[65] pointer-events-none">
  <!-- Background panels that wipe in -->
  <div class="menu-panel absolute inset-0 bg-[#111] origin-left scale-x-0"></div>
  <div class="menu-panel-accent absolute inset-0 bg-[#0a0a0a] origin-left scale-x-0"></div>

  <!-- Menu content -->
  <div class="menu-content absolute inset-0 flex flex-col justify-center px-8 md:px-20 lg:px-32 opacity-0 invisible">
    <nav class="flex flex-col gap-1 md:gap-3 mb-12">
      <a href="#home" class="menu-link group flex items-center gap-6 py-2 md:py-3">
        <span class="text-white/20 text-xs md:text-sm font-mono w-8 group-hover:text-white/50 transition-colors">01</span>
        <span class="text-4xl md:text-6xl lg:text-7xl font-bold text-white tracking-tight group-hover:translate-x-4 transition-transform duration-500">Home</span>
      </a>
      <a href="#projects" class="menu-link group flex items-center gap-6 py-2 md:py-3">
        <span class="text-white/20 text-xs md:text-sm font-mono w-8 group-hover:text-white/50 transition-colors">02</span>
        <span class="text-4xl md:text-6xl lg:text-7xl font-bold text-white tracking-tight group-hover:translate-x-4 transition-transform duration-500">Projects</span>
      </a>
      <a href="#skills" class="menu-link group flex items-center gap-6 py-2 md:py-3">
        <span class="text-white/20 text-xs md:text-sm font-mono w-8 group-hover:text-white/50 transition-colors">03</span>
        <span class="text-4xl md:text-6xl lg:text-7xl font-bold text-white tracking-tight group-hover:translate-x-4 transition-transform duration-500">Skills</span>
      </a>
      <a href="#github" class="menu-link group flex items-center gap-6 py-2 md:py-3">
        <span class="text-white/20 text-xs md:text-sm font-mono w-8 group-hover:text-white/50 transition-colors">04</span>
        <span class="text-4xl md:text-6xl lg:text-7xl font-bold text-white tracking-tight group-hover:translate-x-4 transition-transform duration-500">Activity</span>
      </a>
      <a href="#experience" class="menu-link group flex items-center gap-6 py-2 md:py-3">
        <span class="text-white/20 text-xs md:text-sm font-mono w-8 group-hover:text-white/50 transition-colors">05</span>
        <span class="text-4xl md:text-6xl lg:text-7xl font-bold text-white tracking-tight group-hover:translate-x-4 transition-transform duration-500">Experience</span>
      </a>
      <a href="#testimonials" class="menu-link group flex items-center gap-6 py-2 md:py-3">
        <span class="text-white/20 text-xs md:text-sm font-mono w-8 group-hover:text-white/50 transition-colors">06</span>
        <span class="text-4xl md:text-6xl lg:text-7xl font-bold text-white tracking-tight group-hover:translate-x-4 transition-transform duration-500">Testimonials</span>
      </a>
      <a href="#about" class="menu-link group flex items-center gap-6 py-2 md:py-3">
        <span class="text-white/20 text-xs md:text-sm font-mono w-8 group-hover:text-white/50 transition-colors">07</span>
        <span class="text-4xl md:text-6xl lg:text-7xl font-bold text-white tracking-tight group-hover:translate-x-4 transition-transform duration-500">About</span>
      </a>
      <a href="#contact" class="menu-link group flex items-center gap-6 py-2 md:py-3">
        <span class="text-white/20 text-xs md:text-sm font-mono w-8 group-hover:text-white/50 transition-colors">08</span>
        <span class="text-4xl md:text-6xl lg:text-7xl font-bold text-white tracking-tight group-hover:translate-x-4 transition-transform duration-500">Contact</span>
      </a>
    </nav>

    <!-- Bottom info row -->
    <div class="menu-footer flex flex-col md:flex-row justify-between items-start md:items-end gap-6 border-t border-white/10 pt-6">
      <div class="flex flex-col gap-1">
        <span class="text-xs text-white/30 font-medium">Get in touch</span>
        <a href="mailto:mohit.ashliya@gmail.com" class="text-sm text-white/70 hover:text-white transition-colors">mohit.ashliya@gmail.com</a>
      </div>
      <div class="flex gap-6">
        <a href="https://github.com/babaji1607" target="_blank" rel="noopener noreferrer" class="text-sm text-white/40 hover:text-white transition-colors">Github</a>
        <a href="https://www.linkedin.com/in/mohit-ashliya/" target="_blank" rel="noopener noreferrer" class="text-sm text-white/40 hover:text-white transition-colors">LinkedIn</a>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof gsap === 'undefined') return;

    const trigger = document.getElementById('menu-trigger');
    const overlay = document.getElementById('menu-overlay');
    const panel = document.querySelector('.menu-panel');
    const panelAccent = document.querySelector('.menu-panel-accent');
    const content = document.querySelector('.menu-content');
    const links = document.querySelectorAll('.menu-link');
    const footer = document.querySelector('.menu-footer');
    const menuLines = document.querySelectorAll('.menu-line');

    if (!trigger || !overlay || !panel || !panelAccent || !content) return;

    let isOpen = false;
    const openTl = gsap.timeline({ paused: true });
    const closeTl = gsap.timeline({ paused: true });

    // Open animation
    openTl
      .set(overlay, { pointerEvents: 'auto' })
      .to(panel, { scaleX: 1, duration: 0.5, ease: 'power4.inOut' })
      .to(panelAccent, { scaleX: 1, duration: 0.5, ease: 'power4.inOut' }, '-=0.35')
      .to(content, { autoAlpha: 1, duration: 0.3 }, '-=0.2')
      .from(links, { y: 60, autoAlpha: 0, duration: 0.5, stagger: 0.05, ease: 'power3.out' }, '-=0.2')
      .from(footer, { y: 20, autoAlpha: 0, duration: 0.4, ease: 'power2.out' }, '-=0.3')
      // Morph hamburger to X
      .to(menuLines[0], { rotation: 45, y: 3, duration: 0.3, ease: 'power2.out' }, 0)
      .to(menuLines[1], { rotation: -45, y: -3, duration: 0.3, ease: 'power2.out' }, 0);

    // Close animation
    closeTl
      .to(content, { autoAlpha: 0, duration: 0.2 })
      .to(panelAccent, { scaleX: 0, transformOrigin: 'right', duration: 0.4, ease: 'power4.inOut' }, '-=0.1')
      .to(panel, { scaleX: 0, transformOrigin: 'right', duration: 0.4, ease: 'power4.inOut' }, '-=0.3')
      .set(overlay, { pointerEvents: 'none' })
      // Reset panel origins for next open
      .set(panel, { transformOrigin: 'left', scaleX: 0 })
      .set(panelAccent, { transformOrigin: 'left', scaleX: 0 })
      // Morph X back to hamburger
      .to(menuLines[0], { rotation: 0, y: 0, duration: 0.3, ease: 'power2.out' }, 0)
      .to(menuLines[1], { rotation: 0, y: 0, duration: 0.3, ease: 'power2.out' }, 0);

    trigger.addEventListener('click', () => {
      if (isOpen) {
        closeTl.restart();
        document.body.style.overflow = '';
      } else {
        openTl.restart();
        document.body.style.overflow = 'hidden';
      }
      isOpen = !isOpen;
    });

    // Close on nav link click
    links.forEach(link => {
      link.addEventListener('click', () => {
        if (isOpen) {
          closeTl.restart();
          document.body.style.overflow = '';
          isOpen = false;
        }
      });
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        closeTl.restart();
        document.body.style.overflow = '';
        isOpen = false;
      }
    });
  });
</script>
