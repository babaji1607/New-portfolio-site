const stats = [
  { label: "Infrastructure Uptime", value: "99.99%" },
  { label: "Enterprise Projects", value: "15+" },
  { label: "Avg Cost Reduction", value: "40%" },
  { label: "Client Rating", value: "5.0 ★" }
];
---

<section id="testimonials" class="relative w-full py-32 bg-[#0a0a0a] text-white overflow-hidden border-t border-white/5">
  <!-- Subtle Background Glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[400px] bg-blue-600/5 rounded-full blur-[140px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-8">
      <div>
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-mono tracking-widest uppercase text-blue-400 mb-4">
          <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
          Verified Client Feedback
        </div>
        <h2 class="testi-heading text-4xl md:text-6xl lg:text-7xl font-bold tracking-tighter leading-tight">
          What leaders say
        </h2>
      </div>
      <p class="text-white/60 max-w-md text-base md:text-lg leading-relaxed font-light">
        Trusted by engineering leaders, product founders, and CTOs to deliver mission-critical software, cloud automation, and mobile experiences.
      </p>
    </div>

    <!-- Trust Stats Counter Bar -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 mb-16">
      {stats.map(stat => (
        <div class="bg-[#111] border border-white/[0.08] rounded-2xl p-5 md:p-6 text-center hover:border-white/20 transition-all duration-300">
          <div class="text-3xl md:text-4xl font-bold font-mono tracking-tight text-white mb-1">
            {stat.value}
          </div>
          <div class="text-xs md:text-sm text-white/50 font-medium">
            {stat.label}
          </div>
        </div>
      ))}
    </div>

    <!-- Category Filter Tabs -->
    <div class="flex flex-wrap items-center justify-center md:justify-start gap-3 mb-12">
      <button 
        data-filter="all" 
        class="testi-filter-btn active px-5 py-2.5 rounded-full border border-white/20 bg-white text-black font-medium text-xs md:text-sm tracking-wide transition-all duration-300 cursor-pointer"
      >
        All Endorsements
      </button>
      <button 
        data-filter="devops" 
        class="testi-filter-btn px-5 py-2.5 rounded-full border border-white/10 bg-white/5 text-white/70 hover:text-white hover:bg-white/10 font-medium text-xs md:text-sm tracking-wide transition-all duration-300 cursor-pointer"
      >
        DevOps & CI/CD
      </button>
      <button 
        data-filter="mobile" 
        class="testi-filter-btn px-5 py-2.5 rounded-full border border-white/10 bg-white/5 text-white/70 hover:text-white hover:bg-white/10 font-medium text-xs md:text-sm tracking-wide transition-all duration-300 cursor-pointer"
      >
        Mobile Apps
      </button>
      <button 
        data-filter="cloud" 
        class="testi-filter-btn px-5 py-2.5 rounded-full border border-white/10 bg-white/5 text-white/70 hover:text-white hover:bg-white/10 font-medium text-xs md:text-sm tracking-wide transition-all duration-300 cursor-pointer"
      >
        Cloud & Security
      </button>
    </div>

    <!-- Testimonials Grid -->
    <div class="testimonials-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {testimonials.map((item) => (
        <div 
          data-category={item.category}
          class="testi-card group relative bg-[#111] border border-white/[0.08] rounded-3xl p-8 md:p-9 flex flex-col justify-between hover:border-blue-500/40 hover:bg-[#141416] transition-all duration-500 hover:-translate-y-2 shadow-xl"
        >
          
          <!-- Top Rating & Metric Badge -->
          <div>
            <div class="flex items-center justify-between mb-6">
              <div class="flex gap-1 text-amber-400">
                {[...Array(5)].map(() => (
                  <svg class="w-4 h-4 fill-current drop-shadow" viewBox="0 0 24 24">
                    <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                  </svg>
                ))}
              </div>
              <span class="px-3 py-1 bg-blue-500/10 border border-blue-500/20 rounded-full text-[11px] font-mono font-medium text-blue-300">
                {item.metric}
              </span>
            </div>

            <!-- Quote Text -->
            <p class="text-base md:text-lg text-white/85 leading-relaxed font-normal mb-8 italic">
              "{item.quote}"
            </p>
          </div>

          <!-- Author Info -->
          <div class="flex items-center justify-between pt-6 border-t border-white/[0.06] mt-auto">
            <div class="flex items-center gap-3.5">
              <img 
                src={item.avatar} 
                alt={item.author} 
                class="w-11 h-11 rounded-full object-cover border border-white/20 group-hover:border-blue-400 transition-colors duration-300"
              />
              <div>
                <h4 class="text-sm font-bold text-white leading-snug flex items-center gap-1.5">
                  {item.author}
                  {item.verified && (
                    <svg class="w-3.5 h-3.5 text-blue-400 fill-current inline-block" viewBox="0 0 24 24">
                      <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                    </svg>
                  )}
                </h4>
                <p class="text-xs text-white/50">{item.role} · <span class="text-white/70">{item.company}</span></p>
              </div>
            </div>
            
            <span class="text-[10px] font-mono text-white/30 uppercase tracking-wider hidden sm:block">
              {item.categoryLabel.split(' ')[0]}
            </span>
          </div>

        </div>
      ))}
    </div>

    <!-- Bottom Action Callout -->
    <div class="mt-20 p-8 md:p-12 rounded-3xl bg-gradient-to-r from-white/[0.03] via-white/[0.05] to-white/[0.03] border border-white/10 flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
      <div>
        <h3 class="text-2xl md:text-3xl font-bold tracking-tight mb-2">
          Want to discuss your next project?
        </h3>
        <p class="text-white/60 text-sm md:text-base max-w-xl">
          Whether you need to scale infrastructure, optimize cloud costs, or build a high-performance mobile app, let's connect.
        </p>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-4 shrink-0">
        <a 
          href="#contact" 
          class="px-7 py-3.5 rounded-full bg-white text-black font-semibold text-sm hover:bg-neutral-200 transition-all duration-300 shadow-lg hover:scale-105 active:scale-95"
        >
          Let's Connect Directly
        </a>
      </div>
    </div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;
    gsap.registerPlugin(ScrollTrigger);

    const filterBtns = document.querySelectorAll('.testi-filter-btn');
    const cards = document.querySelectorAll('.testi-card');

    // Filter Functionality
    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        // Toggle active button style
        filterBtns.forEach(b => {
          b.classList.remove('active', 'bg-white', 'text-black', 'border-white/20');
          b.classList.add('bg-white/5', 'text-white/70', 'border-white/10');
        });
        btn.classList.add('active', 'bg-white', 'text-black', 'border-white/20');
        btn.classList.remove('bg-white/5', 'text-white/70', 'border-white/10');

        // Filter cards animation
        cards.forEach(card => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            gsap.to(card, {
              autoAlpha: 1,
              scale: 1,
              display: 'flex',
              duration: 0.4,
              ease: 'power2.out'
            });
          } else {
            gsap.to(card, {
              autoAlpha: 0,
              scale: 0.95,
              duration: 0.3,
              ease: 'power2.in',
              onComplete: () => {
                (card as HTMLElement).style.display = 'none';
              }
            });
          }
        });
      });
    });

    // Initial ScrollTrigger Animations
    const mm = gsap.matchMedia();

    mm.add("(prefers-reduced-motion: no-preference)", () => {
      // Heading reveal
      gsap.from('.testi-heading', {
        y: 30,
        autoAlpha: 0,
        duration: 0.8,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: '#testimonials',
          start: 'top 75%',
          toggleActions: 'play none none none'
        }
      });

      // Cards staggered reveal
      gsap.from('.testi-card', {
        y: 40,
        autoAlpha: 0,
        duration: 0.8,
        stagger: 0.12,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '.testimonials-grid',
          start: 'top 80%',
          toggleActions: 'play none none none'
        }
      });
    });

    mm.add("(prefers-reduced-motion: reduce)", () => {
      gsap.set('.testi-heading, .testi-card', { autoAlpha: 1, y: 0 });
    });
  });
</script>
