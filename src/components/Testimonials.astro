---
// src/components/Testimonials.astro — Static & Guaranteed Visible Testimonials Section
const testimonials = [
  {
    id: 1,
    quote: "Mohit delivered our React Native Gym Booking application seamlessly. His ability to handle real-time tracking for 400+ daily active users while keeping the UI buttery smooth was instrumental to our community's success.",
    author: "Product Lead",
    company: "RudeLabs & Community Partners",
    avatar: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=200",
    metric: "400-500 Daily Users",
    role: "Engineering Manager"
  },
  {
    id: 2,
    quote: "Working with Mohit on the First Step School ERP backend and FastAPI architecture was impressive. He engineered a robust geo-location tracking pipeline and database schema that made attendance verification effortless.",
    author: "Technical Co-Founder",
    company: "First Step ERP Initiative",
    avatar: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&q=80&w=200",
    metric: "FastAPI & PostgreSQL",
    role: "Head of Technology"
  },
  {
    id: 3,
    quote: "Mohit optimized our React Native application performance, tracking down memory leaks and bottlenecks using Expo DevTools. App execution speed improved dramatically, supporting thousands of active users without lag.",
    author: "Client Lead",
    company: "Omzi Product Team",
    avatar: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&q=80&w=200",
    metric: "10k+ Downloads",
    role: "Product Owner"
  }
];

const stats = [
  { label: "Daily Active Users", value: "500+" },
  { label: "YouTube Learners", value: "40K+" },
  { label: "App Downloads", value: "10K+" },
  { label: "Years Experience", value: "2+" }
];
---

<section id="testimonials" class="relative w-full py-32 bg-[#0a0a0a] text-white overflow-hidden border-t border-white/10">
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[400px] bg-indigo-600/10 rounded-full blur-[140px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-8">
      <div>
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-white/15 text-xs font-mono tracking-widest uppercase text-indigo-400 mb-4">
          <span class="w-2 h-2 rounded-full bg-indigo-400 animate-pulse"></span>
          Client & Team Feedback
        </div>
        <h2 class="text-4xl md:text-6xl font-bold tracking-tighter leading-tight text-white">
          Client Endorsements
        </h2>
      </div>
      <p class="text-white/60 max-w-md text-base md:text-lg leading-relaxed font-light">
        Feedback from product owners, team leads, and clients on delivering fullstack web, mobile, and performance solutions.
      </p>
    </div>

    <!-- Trust Stats Counter Bar -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 mb-16">
      {stats.map(stat => (
        <div class="bg-[#111115] border border-white/10 rounded-2xl p-5 md:p-6 text-center hover:border-white/25 transition-all duration-300">
          <div class="text-3xl md:text-4xl font-bold font-mono tracking-tight text-white mb-1">
            {stat.value}
          </div>
          <div class="text-xs md:text-sm text-white/60 font-medium">
            {stat.label}
          </div>
        </div>
      ))}
    </div>

    <!-- Static Testimonials Grid (3 Cards — Always Visible) -->
    <div class="testimonials-grid grid grid-cols-1 md:grid-cols-3 gap-8">
      {testimonials.map((item) => (
        <div class="testi-card group relative bg-[#111115] border border-white/10 rounded-3xl p-8 md:p-9 flex flex-col justify-between hover:border-indigo-500/50 hover:bg-[#14141a] transition-all duration-300 hover:-translate-y-2 shadow-2xl">
          
          <div>
            <div class="flex items-center justify-between mb-6">
              <div class="flex gap-1 text-amber-400">
                {[...Array(5)].map(() => (
                  <svg class="w-4 h-4 fill-current drop-shadow" viewBox="0 0 24 24">
                    <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                  </svg>
                ))}
              </div>
              <span class="px-3 py-1 bg-indigo-500/15 border border-indigo-500/30 rounded-full text-[11px] font-mono font-medium text-indigo-300">
                {item.metric}
              </span>
            </div>

            <p class="text-base text-white/90 leading-relaxed font-normal mb-8 italic">
              "{item.quote}"
            </p>
          </div>

          <div class="flex items-center gap-3.5 pt-6 border-t border-white/10 mt-auto">
            <img 
              src={item.avatar} 
              alt={item.author} 
              class="w-11 h-11 rounded-full object-cover border border-white/20 group-hover:border-indigo-400 transition-colors duration-300"
            />
            <div>
              <h4 class="text-sm font-bold text-white leading-snug">
                {item.author}
              </h4>
              <p class="text-xs text-white/50">{item.role} · <span class="text-white/80">{item.company}</span></p>
            </div>
          </div>

        </div>
      ))}
    </div>

    <!-- Callout -->
    <div class="mt-20 p-8 md:p-12 rounded-3xl bg-gradient-to-r from-white/[0.04] via-white/[0.07] to-white/[0.04] border border-white/15 flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
      <div>
        <h3 class="text-2xl md:text-3xl font-bold tracking-tight mb-2 text-white">
          Ready to build your next web or mobile app?
        </h3>
        <p class="text-white/60 text-sm md:text-base max-w-xl">
          Whether you need a React.js web app, cross-platform React Native app, or FastAPI backend architecture, let's talk.
        </p>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-4 shrink-0">
        <a 
          href="#contact" 
          class="px-7 py-3.5 rounded-full bg-white text-black font-semibold text-sm hover:bg-neutral-200 transition-all duration-300 shadow-lg hover:scale-105 active:scale-95"
        >
          Let's Connect Directly
        </a>
      </div>
    </div>

  </div>
</section>
