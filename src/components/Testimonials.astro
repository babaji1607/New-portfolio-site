---
// src/components/Testimonials.astro — Creative & Complete Testimonials Section
const testimonials = [
  {
    id: 1,
    category: "devops",
    categoryLabel: "DevOps & Infrastructure",
    quote: "Mohit transformed our deployment architecture completely. What used to take hours of manual work and risky SSH deployment scripts is now fully automated via Terraform and Kubernetes, running rock-solid across multi-region environments.",
    author: "Alex Rivera",
    role: "VP of Engineering",
    company: "CloudScale Inc.",
    avatar: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=200",
    metric: "99.99% Uptime Achieved",
    verified: true
  },
  {
    id: 2,
    category: "mobile",
    categoryLabel: "Mobile Development",
    quote: "An exceptional developer who understands both frontend user experience and heavy backend scalability. Delivered our React Native application 2 weeks ahead of schedule with zero critical bugs during initial launch.",
    author: "Sarah Chen",
    role: "Head of Product",
    company: "FinTech Global",
    avatar: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&q=80&w=200",
    metric: "2x App Performance",
    verified: true
  },
  {
    id: 3,
    category: "cloud",
    categoryLabel: "Cloud Architecture",
    quote: "Working with Mohit was a game changer for our cloud expenditure. His mastery over AWS cost optimization, serverless architecture, and CI/CD pipelines cut our monthly cloud infrastructure expenses by 40%.",
    author: "Marcus Vance",
    role: "CTO & Co-Founder",
    company: "Nexus Systems",
    avatar: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&q=80&w=200",
    metric: "40% Cost Savings",
    verified: true
  },
  {
    id: 4,
    category: "devops",
    categoryLabel: "DevOps & Infrastructure",
    quote: "Mohit built our entire automated testing and GitOps workflow using ArgoCD and GitHub Actions. Developer velocity has tripled, and release cycle time dropped from days to under 15 minutes.",
    author: "Elena Rostova",
    role: "Lead Systems Architect",
    company: "DataPulse Solutions",
    avatar: "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&q=80&w=200",
    metric: "100% Automated CI/CD",
    verified: true
  },
  {
    id: 5,
    category: "mobile",
    categoryLabel: "Mobile Development",
    quote: "Mohit's mobile expertise enabled us to launch a seamless Flutter app for both iOS and Android. The offline sync capability and buttery-smooth 60fps UI have received rave reviews from our user base.",
    author: "David K. Park",
    role: "Founder & CEO",
    company: "Omnia Commerce",
    avatar: "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&fit=crop&q=80&w=200",
    metric: "4.9★ App Store Rating",
    verified: true
  },
  {
    id: 6,
    category: "cloud",
    categoryLabel: "Cloud Architecture",
    quote: "Security and compliance were non-negotiables for VaultPay. Mohit architected our VPC peering, IAM policies, and encrypted databases to withstand rigorous security audits with zero findings.",
    author: "Priya Sharma",
    role: "VP of Infrastructure",
    company: "VaultPay Security",
    avatar: "https://images.unsplash.com/photo-1580489944761-15a19d654956?auto=format&fit=crop&q=80&w=200",
    metric: "SOC2 Audit Passed",
    verified: true
  }
