---
// Hero Component — Silent Video & Updated Portfolio Tagline
---
<section id="home" class="relative w-full h-screen overflow-hidden bg-[#0a0a0a] text-white flex items-center justify-center">
  <!-- Progress bar -->
  <div id="scroll-progress" class="fixed top-0 left-0 h-1 bg-white z-50 origin-left scale-x-0 w-full pointer-events-none mix-blend-difference"></div>

  <!-- Video Background (Completely Muted) -->
  <div class="absolute inset-0 w-full h-full z-0 overflow-hidden">
    <video
      id="hero-video"
      autoplay
      loop
      muted
      playsinline
      class="w-full h-full object-cover scale-100 origin-center opacity-40 pointer-events-none"
    >
      <source src="/hero-video.webm" type="video/webm" />
    </video>
  </div>

  <!-- Overlays -->
  <div id="hero-gradient" class="absolute inset-0 bg-gradient-to-b from-[#0a0a0a]/60 via-[#0a0a0a]/40 to-[#0a0a0a] z-0"></div>
  <div class="absolute inset-0 opacity-[0.04] z-0 pointer-events-none mix-blend-overlay" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.8%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E');"></div>

  <!-- Content -->
  <div id="hero-content" class="relative z-10 flex flex-col items-center justify-center max-w-5xl mx-auto px-6 text-center pt-16">
    <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold tracking-tighter leading-tight flex flex-wrap justify-center gap-x-3 md:gap-x-4 gap-y-2 mb-6" aria-label="I build web and mobile applications that scale">
      <span class="word-wrapper overflow-hidden pb-2"><span class="word inline-block invisible">I</span></span>
      <span class="word-wrapper overflow-hidden pb-2"><span class="word inline-block invisible">build</span></span>
      <span class="word-wrapper overflow-hidden pb-2 text-white/70"><span class="word inline-block invisible">&</span></span>
      <span class="word-wrapper overflow-hidden pb-2"><span class="word inline-block invisible">scale</span></span>
      <span class="word-wrapper overflow-hidden pb-2"><span class="word inline-block invisible">web</span></span>
      <span class="word-wrapper overflow-hidden pb-2 text-white/70"><span class="word inline-block invisible">&</span></span>
      <span class="word-wrapper overflow-hidden pb-2"><span class="word inline-block invisible">mobile</span></span>
      <span class="word-wrapper overflow-hidden pb-2"><span class="word inline-block invisible text-transparent bg-clip-text bg-gradient-to-r from-blue-200 via-indigo-300 to-blue-400 font-serif italic">apps</span></span>
      <span class="word-wrapper overflow-hidden pb-2"><span class="word inline-block invisible text-transparent bg-clip-text bg-gradient-to-r from-blue-300 via-indigo-400 to-blue-500 font-serif italic">effortlessly.</span></span>
    </h1>

    <div class="flex flex-wrap items-center justify-center gap-3 md:gap-4 mt-2 mb-10">
      <span class="role-badge invisible px-5 py-2.5 rounded-full border border-white/10 bg-white/5 backdrop-blur-md text-xs md:text-sm font-medium tracking-wide text-indigo-300">Fullstack Developer</span>
      <span class="role-badge invisible px-5 py-2.5 rounded-full border border-white/10 bg-white/5 backdrop-blur-md text-xs md:text-sm font-medium tracking-wide text-blue-300">React & React Native</span>
      <span class="role-badge invisible px-5 py-2.5 rounded-full border border-white/10 bg-white/5 backdrop-blur-md text-xs md:text-sm font-medium tracking-wide text-teal-300">FastAPI & Python</span>
    </div>

    <!-- Direct Connection CTA Button -->
    <div class="hero-cta-wrapper invisible flex flex-col md:flex-row items-center gap-4">
      <a 
        href="#contact" 
        class="group relative inline-flex items-center gap-3 px-8 py-4 rounded-full bg-white text-black font-semibold text-base tracking-wide hover:bg-neutral-200 transition-all duration-300 shadow-xl hover:scale-105 active:scale-95"
      >
        <span>Get in Touch</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
      <a 
        href="#projects" 
        class="group relative inline-flex items-center gap-2 px-7 py-4 rounded-full bg-white/10 text-white font-medium text-base tracking-wide border border-white/15 hover:bg-white/20 transition-all duration-300"
      >
        <span>View Live Projects</span>
      </a>

      <!-- GitHub & LinkedIn Badges -->
      <div class="flex items-center gap-3 mt-2 md:mt-0">
        <a
          href="https://github.com/babaji1607"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-white/5 hover:bg-white/15 border border-white/15 text-sm text-white font-medium transition-all duration-300"
          aria-label="GitHub Profile"
        >
          <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          <span>GitHub</span>
        </a>
        <a
          href="https://www.linkedin.com/in/mohit-ashliya/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-[#0077b5]/20 hover:bg-[#0077b5]/30 border border-[#0077b5]/40 text-sm text-blue-300 font-medium transition-all duration-300"
          aria-label="LinkedIn Profile"
        >
          <svg class="w-4 h-4 text-[#0077b5]" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
          </svg>
          <span>LinkedIn</span>
        </a>
      </div>
    </div>

  </div>

  <!-- Scroll Indicator -->
  <div id="scroll-indicator" class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-3">
    <span class="text-[10px] uppercase tracking-[0.3em] text-white/50 font-medium">Scroll to explore</span>
    <div class="w-[1px] h-12 bg-white/20 relative overflow-hidden">
      <div class="scroll-dot w-full h-1/3 bg-white absolute top-0 left-0"></div>
    </div>
  </div>
</section>

<script>
  // Setup GSAP
  const gsap = window.gsap;
  const ScrollTrigger = window.ScrollTrigger;
  
  if (gsap && ScrollTrigger) {
    gsap.registerPlugin(ScrollTrigger);

    const mm = gsap.matchMedia();

    // Ensure video is strictly muted
    const heroVideo = document.getElementById('hero-video') as HTMLVideoElement;
    if (heroVideo) {
      heroVideo.muted = true;
    }

    mm.add({
      reduceMotion: "(prefers-reduced-motion: reduce)",
      noReduceMotion: "(prefers-reduced-motion: no-preference)"
    }, (context) => {
      const { reduceMotion } = context.conditions;
      
      if (!reduceMotion) {
        // Initial Entry Animation
        const tl = gsap.timeline();
        
        tl.set(".word", { y: 120, rotation: 10, autoAlpha: 0 })
          .set(".role-badge", { y: 30, autoAlpha: 0 })
          .set(".hero-cta-wrapper", { y: 20, autoAlpha: 0 })
          .set(".scroll-dot", { y: -30 });

        tl.to(".word", {
          y: 0,
          rotation: 0,
          autoAlpha: 1,
          duration: 1.4,
          stagger: 0.1,
          ease: "power4.out"
        })
        .to(".role-badge", {
          y: 0,
          autoAlpha: 1,
          duration: 0.8,
          stagger: 0.1,
          ease: "back.out(1.5)"
        }, "-=0.8")
        .to(".hero-cta-wrapper", {
          y: 0,
          autoAlpha: 1,
          duration: 0.8,
          ease: "power3.out"
        }, "-=0.5");
        
        // Scroll Indicator Pulsing
        gsap.to(".scroll-dot", {
          y: 48,
          duration: 1.8,
          repeat: -1,
          ease: "power2.inOut"
        });

        // Parallax and Scroll Effects
        const heroScrollTl = gsap.timeline({
          scrollTrigger: {
            trigger: "#home",
            start: "top top",
            end: "bottom top",
            scrub: true,
          }
        });

        heroScrollTl
          .to("#hero-video", { scale: 1.15, ease: "none" }, 0)
          .to("#hero-content", { y: 200, ease: "none" }, 0)
          .to("#hero-gradient", { autoAlpha: 0.9, ease: "none" }, 0)
          .to("#scroll-indicator", { autoAlpha: 0, y: 50, ease: "none" }, 0);
          
      } else {
        // Reduced motion fallback
        gsap.set(".word", { autoAlpha: 1, y: 0, rotation: 0 });
        gsap.set(".role-badge", { autoAlpha: 1, y: 0 });
        gsap.set(".hero-cta-wrapper", { autoAlpha: 1, y: 0 });
        
        gsap.to("#hero-content", {
          autoAlpha: 0,
          ease: "none",
          scrollTrigger: {
            trigger: "#home",
            start: "top top",
            end: "bottom top",
            scrub: true
          }
        });
      }
      
      // Global scroll progress bar
      gsap.to("#scroll-progress", {
        scaleX: 1,
        ease: "none",
        scrollTrigger: {
          trigger: document.body,
          start: "top top",
          end: "bottom bottom",
          scrub: true
        }
      });
      
    });
  }
</script>
