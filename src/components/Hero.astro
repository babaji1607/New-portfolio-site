---
---
<section id="home" class="relative w-full h-screen min-h-[700px] overflow-hidden bg-[#e5e9f0]">
  
  <!-- Looping Background Video -->
  <video 
    autoplay 
    loop 
    muted 
    playsinline 
    class="absolute inset-0 w-full h-full object-cover z-0"
  >
    <source src="/hero-video.webm" type="video/webm" />
  </video>

  <!-- Text strictly inside the bright sky area of the window -->
  <!-- Positioned roughly in the center of the left window pane -->
  <div class="absolute z-20 left-[45%] top-[18%] w-full max-w-[300px] md:max-w-[400px] text-center transform -translate-x-1/2">
    <h1 class="text-xl md:text-2xl lg:text-3xl font-bold text-gray-900 tracking-tight leading-snug">
      Making and deploying apps <br /> 
      <span class="italic font-serif font-medium text-gray-800">with Ease</span>
    </h1>
  </div>

</section>
