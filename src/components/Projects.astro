---
// Projects.astro — Mohit Ashliya's Resume Projects
const projects = [
  {
    title: "Gym Booking App",
    subtitle: "React Native & Firebase — Live on App Store & Play Store",
    desc: "Built for gated communities to manage gym usage and break times. Serves 400–500 daily users with real-time tracking.",
    tech: ["React Native", "Firebase", "iOS", "Android"],
    image: "https://images.unsplash.com/photo-1534438327276-14e5300c3a48?auto=format&fit=crop&q=80&w=1200",
    badge: "400-500 DAU"
  },
  {
    title: "First Step School ERP",
    subtitle: "React.js, Expo, FastAPI & PostgreSQL",
    desc: "Full school ERP with real-time geo-location attendance tracing, SQLModel ORM, and full admin management dashboard.",
    tech: ["React.js", "React Native Expo", "FastAPI", "PostgreSQL"],
    image: "https://images.unsplash.com/photo-1580582932707-520aed937b7b?auto=format&fit=crop&q=80&w=1200",
    badge: "Live on Play Store"
  },
  {
    title: "Hiranya Jewellery Billing",
    subtitle: "React.js, Tauri & Rust Desktop App",
    desc: "Private desktop billing application for Indian jewellery vendors with secure local data storage and automated billing.",
    tech: ["React.js", "Tauri", "Rust", "Desktop Native"],
    image: "https://images.unsplash.com/photo-1617038260897-41a1f14a8ca0?auto=format&fit=crop&q=80&w=1200",
    badge: "Desktop App"
  },
  {
    title: "Omzi Performance Optimization",
    subtitle: "React Native & Expo Performance Tuning",
    desc: "Identified and fixed critical memory leaks, boosting frame rates to seamlessly support 2,000–4,000 daily active users.",
    tech: ["React Native", "Expo DevTools", "Performance", "Redux"],
    image: "https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&q=80&w=1200",
    badge: "10k+ Downloads"
  },
  {
    title: "Fluid Gradient Generator",
    subtitle: "React.js & Real-time GLSL Shaders",
    desc: "Interactive tool allowing designers and developers to generate custom gradients with instant GLSL code snippet export.",
    tech: ["React.js", "GLSL Shaders", "WebGL", "Tailwind CSS"],
    image: "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&q=80&w=1200",
    badge: "Open Source Tool"
  }
];
---

<section class="bg-[#0a0a0a] text-white relative overflow-hidden" id="projects">
  <div class="container mx-auto px-6 pt-32 pb-16">
    <span class="inline-block text-xs font-mono text-indigo-400 uppercase tracking-widest mb-3">Portfolio Highlights</span>
    <h2 class="text-5xl md:text-8xl font-bold uppercase tracking-tighter" id="projects-title">
      Featured Work
    </h2>
  </div>

  <div class="projects-wrapper h-screen relative" id="projects-wrapper">
    <div class="progress-indicator absolute top-12 left-12 z-20 flex items-end font-mono text-2xl mix-blend-difference pointer-events-none">
      <span class="current-project text-5xl font-bold leading-none text-white">01</span>
      <span class="text-gray-400 ml-2 mb-1">/ 0{projects.length}</span>
    </div>

    <div class="projects-container flex h-full w-[500vw]" id="projects-container">
      {projects.map((project, index) => (
        <div class="project-panel w-screen h-full flex flex-col justify-center items-center relative px-6 md:px-24 shrink-0">
          
          <div class="w-full max-w-7xl relative aspect-[16/9] md:aspect-[21/9] overflow-hidden group rounded-2xl border border-white/10">
            <div class="project-number absolute top-4 right-8 z-10 text-7xl md:text-[11rem] font-bold leading-none text-transparent mix-blend-overlay pointer-events-none" style="-webkit-text-stroke: 2px rgba(255,255,255,0.4);">
              0{index + 1}
            </div>
            
            <div class="image-parallax-container w-full h-full overflow-hidden">
              <img 
                src={project.image} 
                alt={project.title}
                class="project-image w-full h-full object-cover origin-center scale-110 opacity-75 group-hover:opacity-90 transition-opacity duration-700"
              />
            </div>
            
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent group-hover:from-black/80 transition-colors duration-700"></div>
            
            <div class="absolute bottom-6 left-6 md:bottom-12 md:left-12 z-20 max-w-3xl pointer-events-auto">
              <div class="inline-block px-3 py-1 rounded-full bg-indigo-500/20 border border-indigo-500/40 text-xs font-mono font-medium text-indigo-300 mb-3">
                {project.badge}
              </div>

              <h3 class="project-title text-3xl md:text-5xl font-bold mb-2 overflow-hidden text-white">
                <span class="block translate-y-full inline-block">{project.title}</span>
              </h3>

              <p class="text-sm md:text-base text-white/70 mb-5 leading-relaxed max-w-2xl">
                {project.desc}
              </p>
              
              <div class="flex flex-wrap gap-2.5 mb-6">
                {project.tech.map(tech => (
                  <span class="project-tech opacity-0 bg-white/10 backdrop-blur-md px-3.5 py-1.5 rounded-full text-xs font-medium tracking-wide border border-white/20 text-white">
                    {tech}
                  </span>
                ))}
              </div>
            </div>

          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof window.gsap === 'undefined' || typeof window.ScrollTrigger === 'undefined') return;

    const { gsap, ScrollTrigger } = window;
    gsap.registerPlugin(ScrollTrigger);

    const mm = gsap.matchMedia();

    mm.add("(prefers-reduced-motion: no-preference)", () => {
      gsap.from("#projects-title", {
        scrollTrigger: {
          trigger: "#projects",
          start: "top 80%",
          toggleActions: "play none none reverse"
        },
        y: 50,
        autoAlpha: 0,
        duration: 1,
        ease: "power3.out"
      });

      const wrapper = document.getElementById("projects-wrapper");
      const container = document.getElementById("projects-container");
      const panels = gsap.utils.toArray(".project-panel");
      const currentProjectEl = document.querySelector(".current-project");
      
      if (!wrapper || !container || panels.length === 0) return;
      const totalPanels = panels.length;

      const scrollTween = gsap.to(panels, {
        xPercent: -100 * (totalPanels - 1),
        ease: "none",
        scrollTrigger: {
          trigger: wrapper,
          pin: true,
          scrub: 1,
          snap: {
            snapTo: 1 / (totalPanels - 1),
            duration: { min: 0.2, max: 0.6 },
            delay: 0.1,
            ease: "power2.inOut"
          },
          end: () => "+=" + container.offsetWidth,
          onUpdate: (self) => {
            if (currentProjectEl) {
              const progress = self.progress;
              const index = Math.min(
                totalPanels - 1,
                Math.max(0, Math.round(progress * (totalPanels - 1)))
              );
              currentProjectEl.textContent = `0${index + 1}`;
            }
          }
        }
      });

      panels.forEach((panel) => {
        const img = panel.querySelector(".project-image");
        if (img) {
          gsap.to(img, {
            xPercent: 15,
            ease: "none",
            scrollTrigger: {
              trigger: panel,
              containerAnimation: scrollTween,
              start: "left right",
              end: "right left",
              scrub: true
            }
          });
        }

        const titleSpan = panel.querySelector(".project-title span");
        const tags = panel.querySelectorAll(".project-tech");
        
        if (titleSpan) {
          const tl = gsap.timeline({
            scrollTrigger: {
              trigger: panel,
              containerAnimation: scrollTween,
              start: "left 65%",
              toggleActions: "play none none reverse"
            }
          });

          tl.to(titleSpan, {
            y: 0,
            duration: 0.8,
            ease: "power4.out"
          });

          if (tags.length > 0) {
            tl.to(tags, {
              y: 0,
              autoAlpha: 1,
              duration: 0.5,
              stagger: 0.1,
              ease: "back.out(1.2)"
            }, "-=0.5");
          }
        }
      });
    });

    mm.add("(prefers-reduced-motion: reduce)", () => {
      gsap.set("#projects-title", { autoAlpha: 1, y: 0 });
      gsap.set(".project-title span", { y: 0 });
      gsap.set(".project-tech", { autoAlpha: 1, y: 0 });
    });
  });
</script>
