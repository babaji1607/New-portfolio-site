---
const projects = [
  {
    title: "CI/CD Pipeline Automation",
    image: "https://images.unsplash.com/photo-1618401471353-b98afee0b2eb?auto=format&fit=crop&q=80&w=800",
    link: "#"
  },
  {
    title: "FinTech Mobile App",
    image: "https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&q=80&w=800",
    link: "#"
  },
  {
    title: "Cloud Infrastructure Setup",
    image: "https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&q=80&w=800",
    link: "#"
  },
  {
    title: "E-commerce iOS/Android App",
    image: "https://images.unsplash.com/photo-1522199755839-a2bacb67c546?auto=format&fit=crop&q=80&w=800",
    link: "#"
  }
];
---
<section id="projects" class="w-full px-8 py-24 md:px-16 bg-[#f4f4f4]">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-8">
      <h2 class="text-5xl md:text-7xl font-medium tracking-tight text-gray-900">
        Impressive Works
      </h2>
      <p class="max-w-sm text-sm text-gray-500 uppercase tracking-widest leading-relaxed">
        Here's a selection of projects that showcase my passion for DevOps and mobile development, reflecting creativity and innovation.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-16">
      {projects.map((project) => (
        <div class="group cursor-pointer">
          <div class="w-full aspect-[4/3] rounded-3xl overflow-hidden mb-6 bg-gray-200">
            <img src={project.image} alt={project.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out" />
          </div>
          <div class="flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-gray-900 group-hover:text-blue-600 transition-colors"><circle cx="12" cy="12" r="10"/><path d="m10 8 4 4-4 4"/></svg>
            <h3 class="text-xl font-medium text-gray-900">{project.title}</h3>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-16 flex justify-center">
      <a href="#more-projects" class="px-6 py-2 border border-gray-300 rounded-full text-sm font-medium hover:border-gray-900 transition-colors flex items-center gap-2">
        <span class="w-1.5 h-1.5 bg-gray-900 rounded-full"></span> Explore more
      </a>
    </div>
  </div>
</section>
