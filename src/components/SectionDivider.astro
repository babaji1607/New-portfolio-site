---
// SectionDivider.astro — Visual transition between sections
interface Props {
  variant?: 'wave' | 'gradient' | 'line';
  from?: string;
  to?: string;
}

const { variant = 'gradient', from = '#0a0a0a', to = '#f4f4f4' } = Astro.props;
---

{variant === 'gradient' && (
  <div class="section-divider relative h-32 md:h-48 w-full -mt-1 -mb-1" style={`background: linear-gradient(to bottom, ${from}, ${to});`}>
    <!-- Noise overlay on divider -->
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.8%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E');"></div>
  </div>
)}

{variant === 'line' && (
  <div class="section-divider w-full px-6 md:px-16" style={`background-color: ${to};`}>
    <div class="max-w-7xl mx-auto">
      <div class="h-[1px] w-full bg-gradient-to-r from-transparent via-gray-300 to-transparent"></div>
    </div>
  </div>
)}
