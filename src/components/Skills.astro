---
// src/components/Skills.astro — Mohit Ashliya's Technical Stack
const skillsRow1 = ['React.js', 'React Native (Expo)', 'FastAPI (Python)', 'TypeScript', 'Next.js', 'PostgreSQL', 'Tailwind CSS', 'Node.js', 'Firebase', 'Supabase', 'Docker', 'AWS'];
const skillsRow2 = ['Tauri (Rust)', 'Redux Toolkit', 'GLSL Shaders', 'shadcn/ui', 'Framer Motion', 'REST APIs', 'WebSockets', 'Coolify', 'Jest', 'Pytest', 'Git & Actions', 'SQLModel'];

const cards = [
  {
    title: "Web & Frontend",
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>`,
    skills: ["React.js", "Next.js", "TypeScript", "Tailwind CSS", "shadcn/ui", "Redux Toolkit", "Framer Motion"],
    desc: "Modern responsive web applications, interactive UIs, and real-time dashboard interfaces."
  },
  {
    title: "Mobile Development",
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>`,
    skills: ["React Native", "Expo CLI", "iOS", "Android", "Performance Tuning", "App Store Release"],
    desc: "Cross-platform mobile apps for 400–500+ daily active users with smooth 60fps performance."
  },
  {
    title: "Backend & Systems",
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 12h14M12 5l7 7-7 7"></path></svg>`,
    skills: ["FastAPI (Python)", "Express.js", "PHP", "REST APIs", "WebSockets", "Tauri / Rust"],
    desc: "Robust microservice APIs, WebSocket streaming, and performant desktop applications."
  },
  {
    title: "Databases & Storage",
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s-8-1.79-8-4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path></svg>`,
    skills: ["PostgreSQL", "SQLModel ORM", "MongoDB", "MySQL", "Firebase", "Supabase"],
    desc: "Relational schemas, ORM integrations, real-time sync, and optimized database queries."
  },
  {
    title: "DevOps, Cloud & AI",
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"></path></svg>`,
    skills: ["Docker", "AWS (EC2/S3)", "GitHub Actions", "Render", "Coolify", "Cursor & Agentic AI"],
    desc: "Containerized deployments, automated CI/CD pipelines, and AI-assisted engineering workflows."
  },
  {
    title: "Impact Metrics",
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>`,
    skills: [],
    desc: "",
    isStats: true,
    stats: [
      { value: 500, label: "Daily Active Users", suffix: "+" },
      { value: 40, label: "Learners Reached", suffix: "K+" }
    ]
  }
];
---

<section id="skills" class="relative w-full bg-[#0a0a0a] text-white py-32 overflow-hidden">

  <!-- Section heading -->
  <div class="max-w-7xl mx-auto px-6 lg:px-8 mb-20">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-8">
      <div>
        <span class="inline-block text-xs font-mono text-indigo-400 uppercase tracking-widest mb-3">Skills & Technologies</span>
        <h2 class="skills-heading text-4xl md:text-6xl font-bold tracking-tighter leading-none">
          What I work with
        </h2>
      </div>
      <p class="text-white/50 max-w-sm text-base leading-relaxed md:text-right">
        Technologies and frameworks I utilize daily to build scalable web, mobile, and backend systems.
      </p>
    </div>
  </div>

  <!-- Marquee -->
  <div class="marquee-container w-full overflow-hidden flex flex-col gap-4 mb-24 select-none relative">
    <div class="absolute inset-y-0 left-0 w-24 md:w-40 bg-gradient-to-r from-[#0a0a0a] to-transparent z-20 pointer-events-none"></div>
    <div class="absolute inset-y-0 right-0 w-24 md:w-40 bg-gradient-to-l from-[#0a0a0a] to-transparent z-20 pointer-events-none"></div>

    <div class="marquee-row-1 flex whitespace-nowrap">
      <div class="marquee-track flex gap-4 px-2">
        {skillsRow1.map((skill) => (
          <div class="px-5 py-2.5 bg-white/[0.04] border border-white/[0.06] rounded-full text-sm font-medium text-gray-300 hover:bg-white/[0.08] hover:text-white transition-colors duration-300">
            {skill}
          </div>
        ))}
      </div>
      <div class="marquee-track flex gap-4 px-2">
        {skillsRow1.map((skill) => (
          <div class="px-5 py-2.5 bg-white/[0.04] border border-white/[0.06] rounded-full text-sm font-medium text-gray-300">
            {skill}
          </div>
        ))}
      </div>
    </div>

    <div class="marquee-row-2 flex whitespace-nowrap">
      <div class="marquee-track flex gap-4 px-2">
        {skillsRow2.map((skill) => (
          <div class="px-5 py-2.5 bg-white/[0.04] border border-white/[0.06] rounded-full text-sm font-medium text-gray-300 hover:bg-white/[0.08] hover:text-white transition-colors duration-300">
            {skill}
          </div>
        ))}
      </div>
      <div class="marquee-track flex gap-4 px-2">
        {skillsRow2.map((skill) => (
          <div class="px-5 py-2.5 bg-white/[0.04] border border-white/[0.06] rounded-full text-sm font-medium text-gray-300">
            {skill}
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Cards Grid -->
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="skills-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">

      {cards.map((card) => (
        <div class="skill-card group relative rounded-2xl bg-[#111] border border-white/[0.06] p-7 flex flex-col gap-5 hover:border-indigo-500/40 transition-colors duration-500">

          <!-- Header -->
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-white/[0.06] flex items-center justify-center text-indigo-400 group-hover:bg-indigo-500/20 transition-all duration-300">
              <Fragment set:html={card.icon} />
            </div>
            <h3 class="text-lg font-semibold text-white">{card.title}</h3>
          </div>

          {/* Stats card variant */}
          {card.isStats ? (
            <div class="flex-1 flex items-center justify-around py-4">
              {card.stats.map((stat) => (
                <div class="text-center">
                  <div class="flex items-end justify-center gap-0.5">
                    <span class="stat-counter text-3xl md:text-4xl font-black text-white tabular-nums" data-target={String(stat.value)}>0</span>
                    <span class="text-xl md:text-2xl font-bold text-indigo-400">{stat.suffix}</span>
                  </div>
                  <p class="text-xs text-white/50 font-medium mt-1">{stat.label}</p>
                </div>
              ))}
            </div>
          ) : (
            <>
              <p class="text-xs md:text-sm text-white/60 leading-relaxed">{card.desc}</p>

              <div class="flex flex-wrap gap-2 mt-auto pt-2">
                {card.skills.map((skill) => (
                  <span class="px-2.5 py-1 bg-white/[0.04] rounded-lg text-xs font-medium text-white/70 border border-white/[0.06]">
                    {skill}
                  </span>
                ))}
              </div>
            </>
          )}
        </div>
      ))}

    </div>
  </div>
</section>

<script>
  const initSkills = () => {
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;

    gsap.registerPlugin(ScrollTrigger);
    const mm = gsap.matchMedia();

    mm.add("(prefers-reduced-motion: no-preference)", () => {
      gsap.from('.skills-heading', {
        y: 30,
        autoAlpha: 0,
        duration: 0.8,
        ease: "power2.out",
        scrollTrigger: {
          trigger: '#skills',
          start: 'top 75%',
          toggleActions: "play none none reverse"
        }
      });

      const row1 = document.querySelector('.marquee-row-1');
      const row2 = document.querySelector('.marquee-row-2');

      if (row1 && row2) {
        requestAnimationFrame(() => {
          const w1 = row1.scrollWidth / 2;
          const w2 = row2.scrollWidth / 2;

          gsap.fromTo(row1, { x: 0 }, { x: -w1, duration: 25, ease: "none", repeat: -1 });
          gsap.fromTo(row2, { x: -w2 }, { x: 0, duration: 28, ease: "none", repeat: -1 });
        });
      }

      gsap.from('.skill-card', {
        y: 30,
        autoAlpha: 0,
        duration: 0.6,
        stagger: 0.08,
        ease: "power2.out",
        scrollTrigger: {
          trigger: '.skills-grid',
          start: 'top 80%',
          toggleActions: "play none none reverse"
        }
      });

      document.querySelectorAll('.stat-counter').forEach(counter => {
        const target = parseInt(counter.getAttribute('data-target') || '0', 10);
        ScrollTrigger.create({
          trigger: counter,
          start: "top 85%",
          onEnter: () => {
            gsap.to(counter, {
              innerHTML: target,
              duration: 2,
              snap: { innerHTML: 1 },
              ease: "power2.out"
            });
          },
          once: true
        });
      });
    });

    mm.add("(prefers-reduced-motion: reduce)", () => {
      gsap.set('.skills-heading, .skill-card', { autoAlpha: 1, y: 0 });
      document.querySelectorAll('.stat-counter').forEach(c => {
        c.innerHTML = c.getAttribute('data-target') || '0';
      });
    });
  };

  document.addEventListener("DOMContentLoaded", initSkills);
  document.addEventListener("astro:page-load", initSkills);
</script>
