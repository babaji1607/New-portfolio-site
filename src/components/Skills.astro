---
// src/components/Skills.astro
const skillsRow1 = ['Docker', 'Kubernetes', 'AWS', 'React Native', 'Flutter', 'Python', 'TypeScript', 'Go', 'PostgreSQL', 'Redis', 'Jenkins', 'Terraform'];
const skillsRow2 = ['CI/CD', 'GitOps', 'iOS', 'Android', 'Linux', 'MongoDB', 'GraphQL', 'Swift', 'Kotlin', 'Node.js', 'System Design', 'Networking'];

const cards = [
  {
    title: "Mobile Development",
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>`,
    skills: ["React Native", "Flutter", "iOS", "Android", "Swift", "Kotlin"],
    desc: "Cross-platform and native mobile apps with fluid animations and native performance."
  },
  {
    title: "DevOps & Cloud",
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"></path></svg>`,
    skills: ["AWS", "Docker", "Kubernetes", "CI/CD", "Terraform", "Jenkins"],
    desc: "Scalable cloud infrastructure and automated deployment pipelines."
  },
  {
    title: "Programming",
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>`,
    skills: ["Python", "TypeScript", "Go", "JavaScript", "Rust"],
    desc: "Clean, efficient code across multiple paradigms and runtimes."
  },
  {
    title: "Databases",
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path></svg>`,
    skills: ["PostgreSQL", "MongoDB", "Redis", "DynamoDB"],
    desc: "Robust schemas and optimized queries for high-throughput systems."
  },
  {
    title: "Core CS",
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>`,
    skills: ["Linux", "Networking", "System Design", "Microservices"],
    desc: "Deep understanding of systems, architecture patterns, and infrastructure."
  },
  {
    title: "Experience",
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>`,
    skills: [],
    desc: "",
    isStats: true,
    stats: [
      { value: 8, label: "Years Exp." },
      { value: 40, label: "Projects" }
    ]
  }
];
---

<section id="skills" class="relative w-full bg-[#0a0a0a] text-white py-32 overflow-hidden">

  <!-- Section heading -->
  <div class="max-w-7xl mx-auto px-6 lg:px-8 mb-20">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-8">
      <h2 class="skills-heading text-5xl md:text-7xl font-bold tracking-tighter leading-none">
        What I work with
      </h2>
      <p class="text-gray-400 max-w-sm text-base leading-relaxed md:text-right">
        Tools and technologies I use daily to ship reliable software and infrastructure.
      </p>
    </div>
  </div>

  <!-- Marquee -->
  <div class="marquee-container w-full overflow-hidden flex flex-col gap-4 mb-24 select-none relative">
    <div class="absolute inset-y-0 left-0 w-24 md:w-40 bg-gradient-to-r from-[#0a0a0a] to-transparent z-20 pointer-events-none"></div>
    <div class="absolute inset-y-0 right-0 w-24 md:w-40 bg-gradient-to-l from-[#0a0a0a] to-transparent z-20 pointer-events-none"></div>

    <div class="marquee-row-1 flex whitespace-nowrap">
      <div class="marquee-track flex gap-4 px-2">
        {skillsRow1.map((skill) => (
          <div class="px-5 py-2.5 bg-white/[0.04] border border-white/[0.06] rounded-full text-sm font-medium text-gray-300 hover:bg-white/[0.08] hover:text-white transition-colors duration-300">
            {skill}
          </div>
        ))}
      </div>
      <div class="marquee-track flex gap-4 px-2">
        {skillsRow1.map((skill) => (
          <div class="px-5 py-2.5 bg-white/[0.04] border border-white/[0.06] rounded-full text-sm font-medium text-gray-300">
            {skill}
          </div>
        ))}
      </div>
    </div>

    <div class="marquee-row-2 flex whitespace-nowrap">
      <div class="marquee-track flex gap-4 px-2">
        {skillsRow2.map((skill) => (
          <div class="px-5 py-2.5 bg-white/[0.04] border border-white/[0.06] rounded-full text-sm font-medium text-gray-300 hover:bg-white/[0.08] hover:text-white transition-colors duration-300">
            {skill}
          </div>
        ))}
      </div>
      <div class="marquee-track flex gap-4 px-2">
        {skillsRow2.map((skill) => (
          <div class="px-5 py-2.5 bg-white/[0.04] border border-white/[0.06] rounded-full text-sm font-medium text-gray-300">
            {skill}
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Clean uniform grid -->
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="skills-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">

      {cards.map((card) => (
        <div class="skill-card group relative rounded-2xl bg-[#111] border border-white/[0.06] p-7 flex flex-col gap-5 hover:border-white/[0.12] transition-colors duration-500">

          <!-- Header -->
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-white/[0.06] flex items-center justify-center text-white/70 group-hover:bg-white/[0.1] group-hover:text-white transition-all duration-300">
              <Fragment set:html={card.icon} />
            </div>
            <h3 class="text-lg font-semibold text-white">{card.title}</h3>
          </div>

          {/* Stats card variant */}
          {card.isStats ? (
            <div class="flex-1 flex items-center justify-around py-4">
              {card.stats.map((stat) => (
                <div class="text-center">
                  <div class="flex items-end justify-center gap-0.5">
                    <span class="stat-counter text-4xl font-black text-white tabular-nums" data-target={String(stat.value)}>0</span>
                    <span class="text-2xl font-bold text-gray-500">+</span>
                  </div>
                  <p class="text-xs text-gray-500 font-medium mt-1">{stat.label}</p>
                </div>
              ))}
            </div>
          ) : (
            <>
              {/* Description */}
              <p class="text-sm text-gray-400 leading-relaxed">{card.desc}</p>

              {/* Skill pills */}
              <div class="flex flex-wrap gap-2 mt-auto pt-2">
                {card.skills.map((skill) => (
                  <span class="px-3 py-1 bg-white/[0.04] rounded-lg text-xs font-medium text-gray-400 border border-white/[0.04]">
                    {skill}
                  </span>
                ))}
              </div>
            </>
          )}
        </div>
      ))}

    </div>
  </div>
</section>

<style>
  .skill-card {
    will-change: transform;
    transform-style: preserve-3d;
  }
</style>

<script>
  const initSkills = () => {
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;

    gsap.registerPlugin(ScrollTrigger);
    const mm = gsap.matchMedia();

    mm.add("(prefers-reduced-motion: no-preference)", () => {

      // Heading — simple slide up, no scrub fading
      gsap.from('.skills-heading', {
        y: 30,
        autoAlpha: 0,
        duration: 0.8,
        ease: "power2.out",
        scrollTrigger: {
          trigger: '#skills',
          start: 'top 75%',
          toggleActions: "play none none reverse"
        }
      });

      // Marquee
      const row1 = document.querySelector('.marquee-row-1');
      const row2 = document.querySelector('.marquee-row-2');

      if (row1 && row2) {
        requestAnimationFrame(() => {
          const w1 = row1.scrollWidth / 2;
          const w2 = row2.scrollWidth / 2;

          gsap.fromTo(row1, { x: 0 }, { x: -w1, duration: 25, ease: "none", repeat: -1 });
          gsap.fromTo(row2, { x: -w2 }, { x: 0, duration: 28, ease: "none", repeat: -1 });
        });
      }

      // Grid cards — simple stagger from top-left, no wave from center
      gsap.from('.skill-card', {
        y: 30,
        autoAlpha: 0,
        duration: 0.6,
        stagger: 0.08,
        ease: "power2.out",
        scrollTrigger: {
          trigger: '.skills-grid',
          start: 'top 80%',
          toggleActions: "play none none reverse"
        }
      });

      // Stat counters
      document.querySelectorAll('.stat-counter').forEach(counter => {
        const target = parseInt(counter.getAttribute('data-target') || '0', 10);
        ScrollTrigger.create({
          trigger: counter,
          start: "top 85%",
          onEnter: () => {
            gsap.to(counter, {
              innerHTML: target,
              duration: 2,
              snap: { innerHTML: 1 },
              ease: "power2.out"
            });
          },
          once: true
        });
      });

      // 3D tilt on hover
      document.querySelectorAll('.skill-card').forEach(card => {
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          const rx = ((e.clientY - rect.top - rect.height / 2) / rect.height) * -4;
          const ry = ((e.clientX - rect.left - rect.width / 2) / rect.width) * 4;
          gsap.to(card, { rotateX: rx, rotateY: ry, transformPerspective: 800, duration: 0.4, ease: "power2.out" });
        });
        card.addEventListener('mouseleave', () => {
          gsap.to(card, { rotateX: 0, rotateY: 0, duration: 0.6, ease: "power2.out" });
        });
      });
    });

    mm.add("(prefers-reduced-motion: reduce)", () => {
      gsap.set('.skills-heading, .skill-card', { autoAlpha: 1, y: 0 });
      document.querySelectorAll('.stat-counter').forEach(c => {
        c.innerHTML = c.getAttribute('data-target') || '0';
      });
    });
  };

  document.addEventListener("DOMContentLoaded", initSkills);
  document.addEventListener("astro:page-load", initSkills);
</script>
