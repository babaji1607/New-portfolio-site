<section id="about" class="w-full px-8 py-24 md:px-16 bg-[#f4f4f4]">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center gap-16">
    
    <!-- Image Section -->
    <div class="flex-1 w-full md:w-1/2 max-w-md mx-auto md:mx-0">
      <div class="relative w-full aspect-[4/5] rounded-3xl overflow-hidden shadow-2xl">
        <img 
          src="/archperson-g_m_gYi2.png" 
          alt="Profile Image" 
          class="absolute inset-0 w-full h-full object-cover"
        />
        <div class="absolute inset-0 border border-black/10 rounded-3xl"></div>
      </div>
    </div>

    <!-- Text Section -->
    <div class="flex-1 w-full md:w-1/2 flex flex-col items-start gap-8">
      <div class="space-y-4">
        <h2 class="text-sm uppercase tracking-widest text-blue-600 font-semibold">About Me</h2>
        <h3 class="text-2xl md:text-3xl font-medium leading-snug text-gray-900">
          Driven by curiosity and a love for robust architecture.
        </h3>
      </div>
      
      <div class="space-y-6 text-gray-600">
        <p class="leading-relaxed">
          I create simple, functional, and visually striking digital experiences. As a DevOps and Mobile App Developer, I'm always learning and exploring new ideas to build better systems.
        </p>
        <p class="leading-relaxed">
          The fusion of my passion for scalable infrastructure, mobile development, and seamless user experiences places me at the intersection of creativity and technology in the digital world.
        </p>
      </div>

      <a href="#about-more" class="inline-flex items-center gap-2 font-medium text-gray-900 hover:text-blue-600 transition-colors mt-2">
        More about me
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m10 8 4 4-4 4"/></svg>
      </a>
    </div>

  </div>
</section>
