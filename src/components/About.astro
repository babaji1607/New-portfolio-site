---
// src/components/About.astro — Dark theme, no timeline
---
<section id="about" class="relative w-full py-32 bg-[#0a0a0a] text-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 flex flex-col lg:flex-row gap-16 lg:gap-24 items-center">

    <!-- Left: Image & Floating Cards -->
    <div class="w-full lg:w-1/2 relative">
      <div class="about-image-wrapper relative w-full aspect-[4/5] overflow-hidden rounded-2xl bg-[#111]">
        <img src="/archperson-g_m_gYi2.png" alt="Profile" class="about-image w-full h-[115%] object-cover absolute top-[-7%] left-0" />
        <!-- Subtle overlay for depth -->
        <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a]/40 via-transparent to-transparent"></div>
      </div>

      <!-- Floating Cards -->
      <div class="floating-card absolute top-10 -left-3 md:-left-6 bg-white/10 backdrop-blur-md px-4 py-2.5 rounded-xl border border-white/10 flex flex-col items-center z-10">
        <span class="font-bold text-sm text-white">AWS</span>
        <span class="text-xs text-white/50">Certified</span>
      </div>
      <div class="floating-card absolute bottom-20 -right-3 md:-right-6 bg-white/10 backdrop-blur-md px-4 py-2.5 rounded-xl border border-white/10 flex flex-col items-center z-10">
        <span class="font-bold text-sm text-white">50+</span>
        <span class="text-xs text-white/50">Projects</span>
      </div>
      <div class="floating-card absolute top-1/2 -translate-y-1/2 -left-3 md:-left-8 bg-white/10 backdrop-blur-md px-4 py-2.5 rounded-xl border border-white/10 flex flex-col items-center z-10">
        <span class="font-bold text-sm text-white">3+</span>
        <span class="text-xs text-white/50">Years Exp</span>
      </div>
    </div>

    <!-- Right: Text Content -->
    <div class="w-full lg:w-1/2 flex flex-col justify-center">
      <div class="about-text-content">
        <span class="inline-block text-sm font-medium text-white/40 mb-4 tracking-wide">About me</span>
        <h2 class="text-4xl md:text-5xl font-bold leading-tight mb-8 text-white">
          Driven by curiosity and a love for robust architecture.
        </h2>

        <div class="space-y-5 text-base md:text-lg text-white/60 leading-relaxed mb-12">
          <p>
            As a DevOps and Mobile App Developer, I specialize in bridging the gap between scalable infrastructure and seamless user experiences.
          </p>
          <p>
            I believe that great software is built on a foundation of reliability, automation, and intuitive design.
          </p>
        </div>

        <div class="grid grid-cols-2 gap-6 mb-12">
          <div>
            <h4 class="text-sm text-white/30 mb-1">Location</h4>
            <p class="font-medium text-white">San Francisco, CA</p>
          </div>
          <div>
            <h4 class="text-sm text-white/30 mb-1">Status</h4>
            <p class="font-medium text-white flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span> Available for work
            </p>
          </div>
        </div>
      </div>

      <!-- Philosophy Quote -->
      <blockquote class="about-quote text-2xl md:text-3xl font-light italic text-white/70">
        "Build once, deploy everywhere."
      </blockquote>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof gsap === 'undefined') return;
    gsap.registerPlugin(ScrollTrigger);

    const mm = gsap.matchMedia();

    mm.add("(prefers-reduced-motion: no-preference)", () => {
      const img = document.querySelector('.about-image');
      const imgWrapper = document.querySelector('.about-image-wrapper');

      // Image parallax only
      if (img && imgWrapper) {
        gsap.to(img, {
          y: '15%',
          ease: 'none',
          scrollTrigger: {
            trigger: imgWrapper,
            start: 'top bottom',
            end: 'bottom top',
            scrub: true
          }
        });
      }

      // Text — subtle slide up
      gsap.from('.about-text-content', {
        y: 20,
        duration: 0.7,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: '.about-text-content',
          start: 'top 80%',
          toggleActions: 'play none none none'
        }
      });

      // Quote — gentle slide
      gsap.from('.about-quote', {
        x: -15,
        duration: 0.6,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: '.about-quote',
          start: 'top 85%',
          toggleActions: 'play none none none'
        }
      });

      // Floating cards — gentle bob
      const cards = gsap.utils.toArray('.floating-card');
      cards.forEach((card, i) => {
        gsap.to(card, {
          y: -10,
          duration: 2.5 + i * 0.4,
          yoyo: true,
          repeat: -1,
          ease: 'sine.inOut'
        });
      });
    });
  });
</script>
