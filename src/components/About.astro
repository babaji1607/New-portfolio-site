---
// src/components/About.astro — Updated with Mohit Ashliya's Resume Info
---
<section id="about" class="relative w-full py-32 bg-[#0a0a0a] text-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 flex flex-col lg:flex-row gap-16 lg:gap-24 items-center">

    <!-- Left: Image & Floating Cards -->
    <div class="w-full lg:w-1/2 relative">
      <div class="about-image-wrapper relative w-full aspect-[4/5] overflow-hidden rounded-2xl bg-[#111] border border-white/10">
        <img src="/archperson-g_m_gYi2.png" alt="Mohit Ashliya" class="about-image w-full h-[115%] object-cover absolute top-[-7%] left-0" />
        <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a]/60 via-transparent to-transparent"></div>
      </div>

      <!-- Floating Stats Cards -->
      <div class="floating-card absolute top-10 -left-3 md:-left-6 bg-white/10 backdrop-blur-md px-4 py-2.5 rounded-xl border border-white/10 flex flex-col items-center z-10">
        <span class="font-bold text-sm text-white">400–500</span>
        <span class="text-xs text-white/60">Daily Users</span>
      </div>
      <div class="floating-card absolute bottom-20 -right-3 md:-right-6 bg-white/10 backdrop-blur-md px-4 py-2.5 rounded-xl border border-white/10 flex flex-col items-center z-10">
        <span class="font-bold text-sm text-white">40K+</span>
        <span class="text-xs text-white/60">YT Learners</span>
      </div>
      <div class="floating-card absolute top-1/2 -translate-y-1/2 -left-3 md:-left-8 bg-white/10 backdrop-blur-md px-4 py-2.5 rounded-xl border border-white/10 flex flex-col items-center z-10">
        <span class="font-bold text-sm text-white">2+</span>
        <span class="text-xs text-white/60">Years Exp</span>
      </div>
    </div>

    <!-- Right: Text Content & Education -->
    <div class="w-full lg:w-1/2 flex flex-col justify-center">
      <div class="about-text-content">
        <span class="inline-block text-xs font-mono text-indigo-400 uppercase tracking-widest mb-3">About Mohit Ashliya</span>
        <h2 class="text-3xl md:text-5xl font-bold leading-tight mb-6 text-white">
          Fullstack Web & Mobile Application Developer.
        </h2>

        <div class="space-y-4 text-base md:text-lg text-white/70 leading-relaxed mb-8">
          <p>
            I specialize in crafting high-performance React.js web apps, cross-platform React Native mobile applications, and resilient FastAPI backends.
          </p>
          <p>
            Over the past 2+ years, I have architected and launched production applications serving 400–500+ daily users — ranging from Community Gym Booking systems to automated School ERP platforms with real-time geo-tracing.
          </p>
          <p>
            Beyond shipping software, I am passionate about developer education, having mentored over 40K+ learners through interactive coding tutorials.
          </p>
        </div>

        <!-- Details Grid -->
        <div class="grid grid-cols-2 gap-6 mb-8 pt-6 border-t border-white/10">
          <div>
            <h4 class="text-xs font-mono text-white/40 uppercase mb-1">Primary Stack</h4>
            <p class="font-medium text-white text-sm md:text-base">React.js, React Native, FastAPI, Rust/Tauri</p>
          </div>
          <div>
            <h4 class="text-xs font-mono text-white/40 uppercase mb-1">Status</h4>
            <p class="font-medium text-white flex items-center gap-2 text-sm md:text-base">
              <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span> Available for Hire & Projects
            </p>
          </div>
        </div>

        <!-- Education Credentials -->
        <div class="space-y-3 mb-8">
          <h4 class="text-xs font-mono text-indigo-400 uppercase tracking-wider">Education</h4>
          <div class="flex flex-col gap-2.5">
            <div class="bg-[#111] border border-white/[0.08] rounded-xl p-4 flex items-center justify-between">
              <div>
                <h5 class="text-sm font-bold text-white">Master of Computer Applications (MCA)</h5>
                <p class="text-xs text-white/50">Lovely Professional University (LPU)</p>
              </div>
              <span class="text-xs font-mono text-white/40 px-2.5 py-1 rounded bg-white/5">2022–2024</span>
            </div>

            <div class="bg-[#111] border border-white/[0.08] rounded-xl p-4 flex items-center justify-between">
              <div>
                <h5 class="text-sm font-bold text-white">Bachelor of Computer Applications (BCA)</h5>
                <p class="text-xs text-white/50">S.S. Jain Subodh College, Jaipur</p>
              </div>
              <span class="text-xs font-mono text-white/40 px-2.5 py-1 rounded bg-white/5">2019–2022</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Quote -->
      <blockquote class="about-quote text-xl md:text-2xl font-light italic text-white/70 border-l-2 border-indigo-500 pl-4">
        "Building user-friendly solutions that scale gracefully under real-world traffic."
      </blockquote>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof gsap === 'undefined') return;
    gsap.registerPlugin(ScrollTrigger);

    const mm = gsap.matchMedia();

    mm.add("(prefers-reduced-motion: no-preference)", () => {
      const img = document.querySelector('.about-image');
      const imgWrapper = document.querySelector('.about-image-wrapper');

      if (img && imgWrapper) {
        gsap.to(img, {
          y: '15%',
          ease: 'none',
          scrollTrigger: {
            trigger: imgWrapper,
            start: 'top bottom',
            end: 'bottom top',
            scrub: true
          }
        });
      }

      gsap.from('.about-text-content', {
        y: 20,
        duration: 0.7,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: '.about-text-content',
          start: 'top 80%',
          toggleActions: 'play none none none'
        }
      });

      const cards = gsap.utils.toArray('.floating-card');
      cards.forEach((card, i) => {
        gsap.to(card, {
          y: -10,
          duration: 2.5 + i * 0.4,
          yoyo: true,
          repeat: -1,
          ease: 'sine.inOut'
        });
      });
    });
  });
</script>
