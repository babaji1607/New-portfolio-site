---
// src/components/Experience.astro — Concise Timeline with DevOps Focus
const devopsSkills = [
  'Docker', 'Terraform', 'AWS (EC2/S3)', 'GitHub Actions (CI/CD)', 
  'Linux CLI', 'Coolify', 'FastAPI', 'PostgreSQL', 'CloudFormation'
];

const timeline = [
  {
    period: "2025 – Present",
    status: "Current Focus",
    title: "DevOps & Cloud Engineer (Aspiring)",
    company: "Infrastructure & Automation",
    summary: "Deep-diving into cloud infrastructure, Docker containerization, Infrastructure-as-Code with Terraform, and automated GitHub Actions CI/CD pipelines.",
    tags: ["AWS", "Docker", "Terraform", "CI/CD", "Linux", "FastAPI"],
    isCurrent: true,
    badgeColor: "bg-emerald-500/20 text-emerald-400 border-emerald-500/30"
  },
  {
    period: "March 2024 – May 2025",
    status: "RudeLabs",
    title: "Fullstack Software Engineer",
    company: "RudeLabs",
    summary: "Developed real-time financial trading web applications in React.js and launched a React Native gym tracker serving 400–500 daily active users.",
    tags: ["React.js", "React Native", "Firebase", "WebSockets", "UI/UX"],
    isCurrent: false,
    badgeColor: "bg-indigo-500/20 text-indigo-300 border-indigo-500/30"
  },
  {
    period: "March 2023 – Jan 2024",
    status: "RudeLabs",
    title: "Full Stack Developer",
    company: "RudeLabs",
    summary: "Engineered AI-driven React.js & React Native app prototypes for live testing, plus a reliable PHP backend for billing operations.",
    tags: ["React.js", "React Native", "PHP", "Vite", "REST APIs"],
    isCurrent: false,
    badgeColor: "bg-white/10 text-white/70 border-white/15"
  }
];
---

<section id="experience" class="relative w-full py-32 bg-[#0a0a0a] text-white overflow-hidden">
  <!-- Ambient background glow -->
  <div class="absolute top-1/3 left-1/4 w-[500px] h-[300px] bg-indigo-600/10 blur-[130px] rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">

    <!-- Section Heading -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-16">
      <div>
        <span class="inline-block text-xs font-mono text-indigo-400 uppercase tracking-widest mb-3">Timeline & Focus</span>
        <h2 class="text-4xl md:text-6xl font-bold tracking-tighter leading-none text-white">
          Professional Journey
        </h2>
      </div>
      <p class="text-white/60 max-w-md text-base leading-relaxed">
        Fullstack & Mobile engineering foundation transitioning into Cloud Infrastructure & DevOps Engineering.
      </p>
    </div>

    <!-- DevOps Skills Highlight Box -->
    <div class="bg-[#111115] border border-indigo-500/30 rounded-3xl p-6 md:p-8 mb-16 shadow-2xl relative overflow-hidden">
      <div class="absolute top-0 right-0 w-32 h-32 bg-indigo-500/10 rounded-full blur-2xl pointer-events-none"></div>

      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <h3 class="text-lg font-bold text-white tracking-tight">DevOps & Infrastructure Skills</h3>
          </div>
          <p class="text-xs md:text-sm text-white/60 max-w-xl">
            Focusing on automated deployments, containerization, Infrastructure-as-Code, and cloud platform management.
          </p>
        </div>

        <div class="flex flex-wrap gap-2 max-w-lg">
          {devopsSkills.map((skill) => (
            <span class="px-3 py-1.5 rounded-lg bg-indigo-500/15 border border-indigo-500/30 text-xs font-mono font-medium text-indigo-300">
              {skill}
            </span>
          ))}
        </div>
      </div>
    </div>

    <!-- Vertical Timeline Container -->
    <div class="relative pl-6 md:pl-10 border-l-2 border-white/10 space-y-12 ml-2 md:ml-4">
      {timeline.map((item) => (
        <div class="relative group">

          <!-- Timeline Node Bullet -->
          <div class={`absolute -left-[31px] md:-left-[47px] top-1.5 w-5 h-5 rounded-full border-4 border-[#0a0a0a] ${item.isCurrent ? 'bg-emerald-400 shadow-[0_0_12px_rgba(52,211,153,0.8)]' : 'bg-indigo-500'}`}></div>

          <!-- Timeline Card -->
          <div class="bg-[#111115] border border-white/10 hover:border-indigo-500/40 rounded-3xl p-6 md:p-8 transition-all duration-300 shadow-xl">
            
            <!-- Header Row -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4 pb-4 border-b border-white/10">
              <div>
                <div class="flex items-center gap-3 mb-1">
                  <h3 class="text-xl md:text-2xl font-bold text-white tracking-tight">{item.title}</h3>
                  <span class={`px-2.5 py-0.5 rounded-full text-[11px] font-mono font-medium border ${item.badgeColor}`}>
                    {item.status}
                  </span>
                </div>
                <p class="text-sm font-semibold text-indigo-400">{item.company}</p>
              </div>

              <span class="text-xs font-mono text-white/60 bg-white/5 border border-white/10 px-3.5 py-1.5 rounded-full self-start sm:self-auto">
                {item.period}
              </span>
            </div>

            <!-- Concise Summary -->
            <p class="text-sm md:text-base text-white/80 leading-relaxed mb-5">
              {item.summary}
            </p>

            <!-- Tech Tags -->
            <div class="flex flex-wrap gap-2">
              {item.tags.map((tag) => (
                <span class="px-2.5 py-1 bg-white/[0.05] border border-white/10 rounded-md text-xs font-mono text-white/60">
                  #{tag}
                </span>
              ))}
            </div>

          </div>

        </div>
      ))}
    </div>

  </div>
</section>
